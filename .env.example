# Optional for `npm run build` + a separately served frontend, when no reverse
# proxy maps /api to the FastAPI service. Leave this unset during `npm run dev`:
# Vite already proxies /api to http://127.0.0.1:8000.
VITE_MODEL_API_URL=http://127.0.0.1:8000/api

# Optional persistent history. Without these, history is scoped to this browser.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
