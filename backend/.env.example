# Copy this file to .env and adjust values for your machine.
# Forward slashes also work on Windows and avoid escaping backslashes.
MODEL_PATH=D:/Documents/final-project/xlm_roberta_model

# This model has two logits but its exported files do not contain label names.
# Set this only after verifying the label order used during training/export.
# The API maps this logit's probability to "hateful" and the other to "neutral".
HATEFUL_LABEL_INDEX=1

# auto uses CUDA when a compatible PyTorch/CUDA installation is available;
# otherwise it uses CPU. Set to cpu or cuda to force a device.
DEVICE=auto

# XLM-R's bundled tokenizer has a 512-token limit. Inputs are additionally
# validated by the API to 1..2000 characters; whitespace-only input is rejected.
MAX_INPUT_TOKENS=512

# Comma-separated origins allowed to call this local API from the Vite app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# POST /api/analyze response contract:
# {
#   "isHateful": true,
#   "confidence": 98.42,
#   "label": "hateful",
#   "probabilities": { "hateful": 0.9842, "neutral": 0.0158 },
#   "model": { "name": "XLMRobertaForSequenceClassification", "maxInputTokens": 512 }
# }
# confidence is the winning class probability expressed as 0..100.
